---
import {localeFromPath,translator,type Locale} from '../i18n';
const locale:Locale=Astro.props.locale??localeFromPath(Astro.url.pathname);
const t=translator(locale);

import Layout from '../layouts/Layout.astro';

---
<Layout {locale} title={t("nav.resume")}><main id="main" class="page"><div class="page-title"><h1 class="gradient-text">{t("nav.resume")}</h1></div><p class="date">{t("resume.soon")}</p></main></Layout>
