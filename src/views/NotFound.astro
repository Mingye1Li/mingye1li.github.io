---
import {localeFromPath,localizedPath,translator,type Locale} from '../i18n';
const locale:Locale=Astro.props.locale??localeFromPath(Astro.url.pathname);
const t=translator(locale);
const withBase=(path:string)=>localizedPath(path,locale);
import Layout from '../layouts/Layout.astro';

---
<Layout {locale} title={t("error.title")}><main id="main" class="page"><div class="page-title"><h1 class="gradient-text">404</h1></div><p>{t("error.message")}</p><div class="footer-links"><a href={withBase('/')}>← {t("nav.home")}</a><a href={withBase('/blog/')}>{t("error.browse")}</a></div></main></Layout>
